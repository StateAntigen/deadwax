{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadwax",
  "mainBinaryName": "napstrfy",
  "version": "0.2.4-fork",
  "identifier": "net.deadwax.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deadwax",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:* https:; media-src 'self' https: http://127.0.0.1:*; connect-src 'self' ipc: http://127.0.0.1:* http://ipc.localhost https://itunes.apple.com"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "napstrfy"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "napstrfy"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Music",
    "shortDescription": "Your Deadwax music on any device",
    "longDescription": "Deadwax securely connects to your own Deadwax desktop over Iroh.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
